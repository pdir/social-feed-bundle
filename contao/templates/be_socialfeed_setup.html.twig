<div class="tl_listing_container">
  <div id="pdir" class="be_socialfeed_setup clr">
    <hr>
    <h1 id="tl_welcome">{{ lang.setupWelcome|raw }} (Version: {{ version }})</h1>
    <div class="intro">
      <div class="right">
        {{ lang.setupLinks|raw }}
      </div>
      <div class="left">
        <h2>{{ lang.setupHeadline|raw }}</h2>
        <p>{{ lang.setupDesc|raw }}</p>
        <img src="/bundles/pdirsocialfeed/img/pdir_icon_socialfeed_plus.svg" width="70" alt="Social Feed+ Logo" class="plus-logo">
        {{ lang.setupPlus|raw }}
        <p>{{ lang.setupFooter|raw }}</p>
      </div>
      <div class="clr"></div>
    </div>
  </div>
</div>
