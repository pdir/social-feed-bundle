{% extends "@Contao/be_main" %}

{% block main_content %}
  <div class="tl_listing_container">
    <div class="sf-flex-container">
      <div class="sf-account-tile">
        <img src="/bundles/pdirsocialfeedplus/img/icon_plus.svg" width="40" height="40" alt="Add Account">
        <h2>Add Account</h2>
      </div>

      {% for item in items %}
        <div class="sf-account-tile">
          {% if item.avatar %}<img src="{{ item.avatar }}" alt="{{ item.name }}">{% endif %}
          <h2>{{ item.name }}</h2>
          <span>Hinzugefügt am: {{ item.added }}</span>
            <button>aktualisieren</button><button>entfernen</button>
        </div>
      {% else %}
        <div class="sf-account-tile">
            <h2>No accounts found, please add one!</h2>
        </div>
      {% endfor %}
    </div>
  </div>
{% endblock %}


